# Nexora Healthcare Platform Environment Configuration
PROJECT_NAME="Nexora - AI-Powered Healthcare Platform"
SECRET_KEY="nexora-clinical-secure-secret-key-change-in-production-2026-kolhapur"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Configuration
# Leave as localhost or Atlas URI. If unreachable, Nexora uses embedded resilient JSON engine automatically
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="nexora_db"

# Google Maps Platform Places API (New)
# Leave empty to run with verified Kolhapur offline healthcare dataset (CPR Hospital, Aster Aadhar, etc.)
# Provide your Google Cloud key with Places API (New) enabled for live data:
GOOGLE_MAPS_API_KEY=""

# Local Ollama LLM Configuration
# Nexora connects to local Ollama if running. If offline, high-fidelity clinical synthesis is used.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
